{
  "name": "routibell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "predev": "node 도구/이름동기화.mjs",
    "prebuild": "node 도구/이름동기화.mjs",
    "start": "npm run build && npm run preview",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test 검증/*.test.js",
    "db:migrate": "node 도구/계정DB이전.mjs",
    "db:verify": "node 도구/계정동시검증.mjs",
    "monitor:health": "node 도구/서버상태확인.mjs",
    "youcam:prepare": "npm start",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "^8.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
